#!/usr/bin/env python3
"""
wt-status / wt — see every git worktree on your machine, and clean them up safely.

Finds the worktrees created by Claude Code, Codex, Cursor, Orca or by hand, tells you
which ones still hold work and which ones can go, and lets you remove them.

  wt                       interactive TUI: browse, tick, delete      (= wt-status -i)
  wt-status                plain report, grouped by state
  wt-status --size         ... with the disk size of each worktree (slower)
  wt-status --repo api     only repos whose name contains "api"
  wt-status --clean        remove every *removable* worktree, after confirmation
  wt-status --clean --yes  ... without confirmation

Safety: nothing is deleted without an explicit action. Normal removal is
`git worktree remove` without --force, so git itself refuses if anything is
uncommitted. Branches are never deleted. Forced removal (TUI, key `D`) first saves
uncommitted changes with `git stash` and keeps unpushed commits on a branch.

Scanned folders: arguments, else $WT_ROOTS (colon-separated), else common code folders.
Language: English, or French when $WT_LANG / $LANG starts with "fr".
Requires Python >= 3.8 and git >= 2.17. No third-party dependency.
"""
import argparse
import os
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor

__version__ = "0.1.0"

